{
  "name": "fortipi-client",
  "version": "0.1.0",
  "description": "FortiPi client",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottdraper8/fortipi.git",
    "directory": "packages/fortipi-client"
  },
  "publishConfig": {
