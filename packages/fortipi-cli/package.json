{
  "name": "fortipi-cli",
  "version": "0.1.0",
  "description": "FortiPi cli",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottdraper8/fortipi.git",
    "directory": "packages/fortipi-cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "26.13.1"
  },
  "exports": {
