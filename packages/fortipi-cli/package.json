    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "templates",
    "worker-assets"
  ],
  "bin": {
    "fortipi": "./dist/bin.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "fortipi-contract": "workspace:*",
    "wrangler": "4.162.0",
    "ajv": "8.20.0"
  }
