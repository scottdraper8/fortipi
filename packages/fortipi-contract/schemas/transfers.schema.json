    "TransferStatus": {
      "title": "TransferStatus",
      "type": "object",
      "properties": {
        "transferId": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
        },
        "attemptId": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
        },
        "state": {
          "enum": ["waiting", "streaming", "verified", "interrupted", "expired"]
        },
        "verifiedChunks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "maxItems": 256
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["transferId", "attemptId", "state", "verifiedChunks", "bytes"],
      "additionalProperties": false
