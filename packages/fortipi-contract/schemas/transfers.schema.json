      },
      "required": ["attemptId"],
      "additionalProperties": false
    },
    "TransferChunkQuery": {
      "title": "TransferChunkQuery",
      "type": "object",
      "properties": {
        "attemptId": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "sha256": {
