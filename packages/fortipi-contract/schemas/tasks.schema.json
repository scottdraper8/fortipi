{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortipi.dev/schemas/1.0.0/tasks.schema.json",
  "title": "tasks schema",
  "description": "FortiPi protocol 1.0 / schema 1.0.0. Known records are closed. Cross-field authority and temporal predicates are enforced by the owning consumer; see the contract README.",
  "$ref": "https://fortipi.dev/schemas/1.0.0/tasks.schema.json#/$defs/Task",
  "$defs": {
    "TaskState": {
      "title": "TaskState",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "idle",
                "queued",
                "running",
                "completed",
                "failed",
                "interrupted",
                "cancelled"
              ]
            }
          },
          "required": ["state"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "waiting"
            },
            "reason": {
              "enum": [
                "model",
                "cloud-tool",
                "local-device",
                "human-approval",
                "local-policy",
                "reconciliation",
                "workspace-conflict",
                "kept-input"
              ]
            },
            "supportedContinuations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxItems": 100
            }
          },
          "required": ["state", "reason", "supportedContinuations"],
          "additionalProperties": false
        }
      ]
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
        },
        "conversationId": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/tasks.schema.json#/$defs/TaskState"
        }
      },
      "required": ["taskId", "conversationId", "version", "status"],
      "additionalProperties": false
    },
    "TaskControl": {
      "title": "TaskControl",
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["requestId"],
      "additionalProperties": false
    },
    "TaskResume": {
      "title": "TaskResume",
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
        },
        "continuation": {
          "enum": ["next-submit", "retry-approved", "resume"]
        }
      },
      "required": ["requestId", "continuation"],
      "additionalProperties": false
    }
  }
}
