{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortipi.dev/schemas/1.0.0/configuration.schema.json",
  "title": "configuration schema",
  "description": "FortiPi protocol 1.0 / schema 1.0.0. Known records are closed. Cross-field authority and temporal predicates are enforced by the owning consumer; see the contract README.",
  "$ref": "https://fortipi.dev/schemas/1.0.0/configuration.schema.json#/$defs/Configuration",
  "$defs": {
    "WorkspaceConfig": {
      "title": "WorkspaceConfig",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "computer"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local"
            },
            "executorId": {
              "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
            },
            "rootBindingId": {
              "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
            }
          },
          "required": ["kind", "executorId", "rootBindingId"],
          "additionalProperties": false
        }
      ]
    },
    "BackendConfig": {
      "title": "BackendConfig",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cloud-js"
            },
            "backendId": {
              "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "maxItems": 100
            },
            "egress": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 100
            },
            "onInterrupt": {
              "const": "fail"
            }
          },
          "required": ["kind", "backendId", "modules", "egress", "onInterrupt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "linux"
            },
            "backendId": {
              "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
            },
            "host": {
              "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
            },
            "imageDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "runtime": {
              "type": "object",
              "properties": {
                "cpuMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400000
                },
                "memoryBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400000
                }
              },
              "required": ["cpuMs", "memoryBytes", "timeoutMs"],
              "additionalProperties": false
            }
          },
          "required": ["kind", "backendId", "host", "imageDigest", "runtime"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "native"
            },
            "executorId": {
              "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
            },
            "trust": {
              "enum": ["host", "isolated"]
            }
          },
          "required": ["kind", "executorId", "trust"],
          "additionalProperties": false
        }
      ]
    },
    "ProviderAuthConfig": {
      "title": "ProviderAuthConfig",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "secretRef"
            },
            "secretRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "required": ["kind", "secretRef"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "oauth"
            },
            "providerId": {
              "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
            }
          },
          "required": ["kind", "providerId"],
          "additionalProperties": false
        }
      ]
    },
    "ModelConfig": {
      "title": "ModelConfig",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "providerId": {
              "const": "cloudflare"
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": ["providerId", "modelId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "providerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "not": {
                "const": "cloudflare"
              }
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "auth": {
              "$ref": "https://fortipi.dev/schemas/1.0.0/configuration.schema.json#/$defs/ProviderAuthConfig"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": ["providerId", "modelId", "auth"],
          "additionalProperties": false
        }
      ]
    },
    "Configuration": {
      "title": "Configuration",
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workspace": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/configuration.schema.json#/$defs/WorkspaceConfig"
        },
        "execution": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/configuration.schema.json#/$defs/BackendConfig"
        },
        "routing": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": ["prefer-local", "cloud", "explicit"]
            },
            "targetIds": {
              "type": "array",
              "items": {
                "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
              },
              "maxItems": 100
            }
          },
          "required": ["kind", "targetIds"],
          "additionalProperties": false
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "https://fortipi.dev/schemas/1.0.0/configuration.schema.json#/$defs/ModelConfig"
          },
          "maxItems": 32
        },
        "infrastructure": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/infrastructure.schema.json#/$defs/InfrastructurePolicy"
        }
      },
      "required": ["version", "workspace", "execution", "routing", "models", "infrastructure"],
      "additionalProperties": false
    },
    "ConfigurationPatch": {
      "title": "ConfigurationPatch",
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/common.schema.json#/$defs/Id"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "configuration": {
          "$ref": "https://fortipi.dev/schemas/1.0.0/configuration.schema.json#/$defs/Configuration"
        }
      },
      "required": ["requestId", "expectedVersion", "configuration"],
      "additionalProperties": false
    }
  }
}
