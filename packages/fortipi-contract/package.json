{
  "name": "fortipi-contract",
  "version": "0.1.0",
  "description": "FortiPi contract",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottdraper8/fortipi.git",
    "directory": "packages/fortipi-contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./executor": {
      "types": "./dist/executor.d.ts",
      "import": "./dist/executor.js"
    },
    "./schemas/*": "./schemas/*",
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "schemas",
    "openapi.yaml"
  ],
  "devDependencies": {
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0"
  }
}
