{
  "name": "fortipi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "build": "node scripts/build-workspaces.ts build",
    "typecheck": "node scripts/build-workspaces.ts typecheck",
    "typecheck:executor": "node scripts/build-workspaces.ts typecheck:executor",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "lint": "biome check .",
    "schema:check": "node packages/fortipi-contract/scripts/generate.ts --check",
    "check:pins": "node scripts/check-pins.ts",
    "review:supply-chain": "node tools/unstale/review-supply-chain.ts --locks --check",
    "check:licenses": "node scripts/check-licenses.ts",
    "unstale:check": "node scripts/run-unstale.ts",
    "test": "node scripts/build-workspaces.ts test",
    "test:executor": "node scripts/build-workspaces.ts test:executor",
    "test:browser": "node scripts/build-workspaces.ts test:browser",
    "test:pty": "node scripts/build-workspaces.ts test:pty",
    "verify:foundation": "node scripts/verify-foundation.ts",
    "install:frozen": "node scripts/install-dependencies.ts",
    "build:executor": "node scripts/build-workspaces.ts build:executor",
    "candidate:local": "node scripts/build-workspaces.ts candidate"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@babel/types": "8.1.0",
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@xterm/headless": "6.0.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "node-gyp": "13.1.0",
    "node-pty": "1.1.0",
    "playwright": "1.65.0",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "fortipi": {
    "toolchain": {
      "node": "26.13.1",
      "pnpm": "12.18.0",
      "python": "3.15.2",
      "go": "1.27.4",
      "preCommit": "4.7.0",
      "npm": "11.20.0"
    },
    "actions": {
      "step-security/harden-runner": {
        "version": "v2.22.4",
        "sha": "1d88384fd173af6ecb012dfd0264a306b711241a"
      },
      "actions/checkout": {
        "version": "v7.0.1",
        "sha": "3d3c42e5aac5ba805825da76410c181273ba90b1"
      },
      "actions/setup-node": {
        "version": "v7.1.0",
        "sha": "949feb2413d6458794dcd2491c4babbbce0c15c1"
      },
      "pnpm/action-setup": {
        "version": "v6.1.1",
        "sha": "73e46992e05b19abd31f2f3c20e0e7370d762115"
      },
      "actions/setup-python": {
        "version": "v7.1.0",
        "sha": "6d4fd22b20465ccc0f7354476588e8df7c9ca0e0"
      },
      "actions/setup-go": {
        "version": "v7.0.0",
        "sha": "b7ad1dad31e06c5925ef5d2fc7ad053ef454303e"
      },
      "actions/upload-artifact": {
        "version": "v7.0.2",
        "sha": "cf430e030ddbb5b0abf93d22962f4752f3646cd9"
      },
      "actions/download-artifact": {
        "version": "v8.0.2",
        "sha": "9000827ccba6bdab643e8b6fd33ac0654aef8333"
      },
      "softprops/action-gh-release": {
        "version": "v3.0.4",
        "sha": "8a0cd651e5b2365bd640854a3fa5dfc70e4875f3"
      }
    },
    "publishNames": {
      "fortipi-contract": "@{scope}/fortipi-contract",
      "fortipi-client": "@{scope}/fortipi-client",
      "fortipi-tui": "@{scope}/fortipi-tui",
      "fortipi-cli": "@{scope}/fortipi-cli",
      "fortipi-executor": "@{scope}/fortipi-executor"
    }
  }
}
